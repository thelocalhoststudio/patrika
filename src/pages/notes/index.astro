---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import Section from "@/components/Section.astro";
import NotesGrid from "@/components/NotesGrid.astro";
import { getAllNotes } from "@/utils/content";

const allNotes = await getAllNotes();
---

<BaseLayout title="Notes">
  <div class="layout-content">
    <PageHeader
      eyebrow="Notes"
      title="Notes"
      lede="Short and provisional — the habit of writing things down carefully."
    />
    <Section>
      <NotesGrid notes={allNotes} />
    </Section>
  </div>
</BaseLayout>
