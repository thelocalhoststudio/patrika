---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseTabs from "@/components/BrowseTabs.astro";
import BrowseDimensions from "@/components/BrowseDimensions.astro";
import { getAllPosts, getAllNotes, getAllEntries } from "@/utils/content";
import { getConfig } from "@/utils/config";

const siteConfig = await getConfig();
const indexes = siteConfig.browse?.indexes ?? [];
const showYears = siteConfig.browse?.years ?? false;

const allPosts = await getAllPosts();
const allNotes = await getAllNotes();
const allEntries = await getAllEntries();
---

<BaseLayout title="Browse">
  <div class="layout-content">
    <PageHeader
      eyebrow="Browse"
      title="Browse"
      lede="A field notebook's index — by year, place, or trip."
    />

    <BrowseTabs defaultTab="all">
      <Fragment slot="all">
        <BrowseDimensions entries={allEntries} indexes={indexes} showYears={showYears} />
      </Fragment>
      <Fragment slot="essays">
        <BrowseDimensions entries={allPosts} indexes={indexes} showYears={showYears} />
      </Fragment>
      <Fragment slot="notes">
        <BrowseDimensions entries={allNotes} indexes={indexes} showYears={showYears} />
      </Fragment>
    </BrowseTabs>
  </div>
</BaseLayout>
