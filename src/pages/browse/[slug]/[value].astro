---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseTabs from "@/components/BrowseTabs.astro";
import BrowseList from "@/components/BrowseList.astro";
import { getAllPosts, getAllNotes, getAllEntries } from "@/utils/content";
import { getMetaValues, filterByMetaSlug } from "@/utils/browse";
import { getConfig } from "@/utils/config";
import { getAssetPath } from "@/utils/url";
import type { BrowseIndexConfig } from "@/types";

export async function getStaticPaths() {
  const siteConfig = await getConfig();
  const indexes = siteConfig.browse?.indexes ?? [];
  const allEntries = await getAllEntries();

  return indexes.flatMap((index) =>
    getMetaValues(allEntries, index.key).map(({ value, slug }) => ({
      params: { slug: index.slug, value: slug },
      props: { index, value },
    }))
  );
}

interface Props {
  index: BrowseIndexConfig;
  value: string;
}

const { index, value } = Astro.props as Props;
const { value: valueSlug } = Astro.params;

const allEntries = await getAllEntries();
const allPosts = await getAllPosts();
const allNotes = await getAllNotes();
---

<BaseLayout title={`${value} · ${index.title}`}>
  <div class="layout-content">
    <a
      href={getAssetPath(`browse/${index.slug}`)}
      class="font-mono text-xs uppercase tracking-wide text-clay hover:underline"
    >
      ← {index.title}
    </a>

    <PageHeader eyebrow={` Browse — ${index.title}`} title={value} />

    <BrowseTabs defaultTab="all">
      <Fragment slot="all">
        <BrowseList entries={filterByMetaSlug(allEntries, index.key, valueSlug!)} />
      </Fragment>
      <Fragment slot="essays">
        <BrowseList entries={filterByMetaSlug(allPosts, index.key, valueSlug!)} />
      </Fragment>
      <Fragment slot="notes">
        <BrowseList entries={filterByMetaSlug(allNotes, index.key, valueSlug!)} />
      </Fragment>
    </BrowseTabs>
  </div>
</BaseLayout>
