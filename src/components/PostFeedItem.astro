---
import type { CollectionEntry } from "astro:content";
import ImageWrapper from "@/components/ImageWrapper.astro";
import { getCoverImage } from "@/utils/image";
import { getPostUrl, getNoteUrl } from "@/utils/content";
import { formatDate, formatMonthYear } from "@/utils/text";

interface Props {
  post: CollectionEntry<"posts"> | CollectionEntry<"notes">;
  variant?: "default" | "featured" | "archive";
}

const {
  post,
  variant = "default",
} = Astro.props;

const isNote = post.collection === "notes";
const cover = isNote ? undefined : getCoverImage(post.data.cover);
const date = formatDate(post.data.published);
const monthYear = formatMonthYear(post.data.published);
const href = isNote
  ? getNoteUrl(post.id, post.filePath)
  : getPostUrl(post.id, post.filePath);
const typeLabel = isNote ? "Note" : "Essay";

const isFeatured = variant === "featured";
const isArchive = variant === "archive";
---

<article
  class:list={[
    "group",
    {
      "flex flex-col md:flex-row gap-6": isFeatured,
      "flex flex-col md:flex-row gap-4 py-6":
        !isFeatured && !isArchive,
      "grid grid-cols-[5rem_1fr_auto] items-baseline gap-4 py-4": isArchive,
    },
  ]}
>
  {isFeatured && (
    <ImageWrapper
      src={cover}
      alt={post.data.title}
      class="md:w-80 shrink-0"
    />
  )}

  {isArchive ? (
    <>
      <div class="flex flex-col gap-1">
        <time
          datetime={post.data.published.toISOString()}
          class="font-mono text-xs text-muted-foreground tabular-nums"
        >
          {monthYear}
        </time>
        <span class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground/70">
          {typeLabel}
        </span>
      </div>

      <div class="space-y-1">
        <h3 class="font-serif text-lg leading-snug">
          <a href={href} class="group-hover:underline">
            {post.data.title}
          </a>
        </h3>

        {post.data.description && (
          <p class="text-sm italic text-muted-foreground">
            {post.data.description}
          </p>
        )}
      </div>

      <a
        href={href}
        aria-hidden="true"
        tabindex="-1"
        class="self-center font-mono text-muted-foreground/50 transition-colors group-hover:text-foreground"
      >
        →
      </a>
    </>
  ) : (
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <time
          datetime={post.data.published.toISOString()}
          class="rounded-xs border border-border px-1 font-mono text-xs uppercase tabular-nums text-muted-foreground"
        >
          {date}
        </time>

        {post.data.category && (
          <span class="font-mono text-xs uppercase text-muted-foreground">
            {post.data.category}
          </span>
        )}
      </div>

      <div class="space-y-2">
        <h3
          class:list={[
            "font-serif leading-tight",
            {
              "text-2xl": isFeatured,
              "text-xl": !isFeatured,
            },
          ]}
        >
          <a
            href={href}
            class="group-hover:underline"
          >
            {post.data.title}
          </a>
        </h3>

        {post.data.description && (
          <p class="text-sm italic text-muted-foreground">
            {post.data.description}
          </p>
        )}
      </div>
    </div>
  )}
</article>