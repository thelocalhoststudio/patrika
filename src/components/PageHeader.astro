---
interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
}

const { title, eyebrow, lede } = Astro.props;
---

<header class="mt-2 border-b border-border/50 py-6 md:mt-4 md:py-8">
  {eyebrow && (
    <p class="mb-4 font-mono text-xs uppercase text-muted-foreground/70">
      {eyebrow}
    </p>
  )}

  <div class="flex flex-col gap-4 md:flex-row md:items-baseline md:justify-between">
    <h1 class="font-serif text-3xl font-light italic leading-tight tracking-tight">
      {title}
    </h1>

    {lede && (
      <p class="max-w-sm font-serif text-sm font-light italic leading-relaxed text-muted-foreground">
        {lede}
      </p>
    )}
  </div>
</header>