---
import { type CollectionEntry } from "astro:content";
import NoteCard from "./NoteCard.astro";

interface Props {
  notes: CollectionEntry<"notes">[];
}

const { notes } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {notes.map((note) => (
    <NoteCard note={note} />
  ))}
</div>