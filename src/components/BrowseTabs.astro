---
/**
 * CSS-only collection-type tabs (All / Essays / Notes). No JS: three radio
 * inputs drive `peer-checked` visibility on three fully server-rendered
 * panels, passed in via the `all` / `essays` / `notes` named slots.
 *
 * Extracted from archive.astro so the same mechanism can be reused by the
 * browse pages without duplicating it.
 */
interface Props {
  defaultTab?: "all" | "essays" | "notes";
  groupName?: string;
}

const { defaultTab = "all", groupName = "collection-filter" } = Astro.props;
---

<div class="mt-8">
  <input
    type="radio"
    name={groupName}
    id={`${groupName}-all`}
    class="peer/all sr-only"
    checked={defaultTab === "all"}
  />
  <input
    type="radio"
    name={groupName}
    id={`${groupName}-essays`}
    class="peer/essays sr-only"
    checked={defaultTab === "essays"}
  />
  <input
    type="radio"
    name={groupName}
    id={`${groupName}-notes`}
    class="peer/notes sr-only"
    checked={defaultTab === "notes"}
  />

  <nav class="flex gap-6 border-b border-border/50 pb-4 font-mono text-xs uppercase tracking-wide text-muted-foreground">
    <label
      for={`${groupName}-all`}
      class="cursor-pointer transition-colors hover:text-foreground peer-checked/all:text-foreground peer-checked/all:underline peer-checked/all:underline-offset-4"
    >
      All
    </label>
    <label
      for={`${groupName}-essays`}
      class="cursor-pointer transition-colors hover:text-foreground peer-checked/essays:text-foreground peer-checked/essays:underline peer-checked/essays:underline-offset-4"
    >
      Essays
    </label>
    <label
      for={`${groupName}-notes`}
      class="cursor-pointer transition-colors hover:text-foreground peer-checked/notes:text-foreground peer-checked/notes:underline peer-checked/notes:underline-offset-4"
    >
      Notes
    </label>
  </nav>

  <div class="hidden peer-checked/all:block">
    <slot name="all" />
  </div>

  <div class="hidden peer-checked/essays:block">
    <slot name="essays" />
  </div>

  <div class="hidden peer-checked/notes:block">
    <slot name="notes" />
  </div>
</div>
