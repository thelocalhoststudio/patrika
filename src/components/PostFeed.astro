---
import type { CollectionEntry } from "astro:content";
import PostFeedItem from "./PostFeedItem.astro";

interface Props {
  posts: (CollectionEntry<"posts"> | CollectionEntry<"notes">)[];
  variant?: "default" | "featured" | "archive";
}

const { posts, variant } = Astro.props;
---

<div class="">
  {posts.map(post => (
    <PostFeedItem post={post} variant={variant} />
  ))}
</div>