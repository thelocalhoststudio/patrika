---
interface Item {
  label: string;
  href:  string;
}

interface Props {
  items: Item[];
  emptyMessage?: string;
}

const { items, emptyMessage = "Nothing here yet." } = Astro.props;
---

{items.length > 0 ? (
  <ul class="space-y-2">
    {items.map((item) => (
      <li>
        <a href={item.href} class="font-serif text-lg hover:underline">
          {item.label}
        </a>
      </li>
    ))}
  </ul>
) : (
  <p class="text-sm italic text-muted-foreground">{emptyMessage}</p>
)}
