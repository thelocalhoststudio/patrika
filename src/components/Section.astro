---
interface Props {
  title?: string;
  href?: string;
  action?: string;
  level?: "h2" | "h3" | "h4";
  class?: string;
}

const {
  title,
  href,
  action = "View All →",
  level = "h2",
  class: className,
} = Astro.props;

const Heading = level;
---

<section class:list={["pt-8", className]}>
  {title && (
    <header class="mb-6 flex items-center justify-between">
      <Heading class="font-sans text-xs uppercase text-muted-foreground/70">
        {title}
      </Heading>

      {href && (
        <a
          href={href}
          class="font-mono text-xs uppercase text-muted-foreground/70 hover:text-foreground"
        >
          {action}
        </a>
      )}
    </header>
  )}

  <slot />
</section>